{
  "expo": {
    "name": "acasa",
    "slug": "app-cristao",
    "owner": "baux-tech",
    "scheme": "acasa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bauxtech.acasa",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.bauxtech.acasa",
      "adaptiveIcon": {
        "backgroundColor": "#254C3A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 180,
          "backgroundColor": "#254C3A"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O microfone é usado para gravar o culto e transformar a pregação em texto para você.",
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "A câmera é usada para tirar a sua foto de perfil, gravar pedidos em Libras, ler o QR code da célula e fotografar o cronograma do curso, a capa e os materiais.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O Face ID é usado para proteger o seu diário de oração e as suas anotações."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "As fotos são usadas para a sua foto de perfil, o cronograma do curso, a capa e o logo da célula e os materiais que você escolher.",
          "cameraPermission": "A câmera é usada para tirar a sua foto de perfil, gravar pedidos em Libras, ler o QR code da célula e fotografar o cronograma do curso, a capa e os materiais."
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#254C3A"
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "e3e9e31b-1ad3-4cb4-bd06-22861dd53537"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e3e9e31b-1ad3-4cb4-bd06-22861dd53537",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
