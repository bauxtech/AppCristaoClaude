{
  "expo": {
    "name": "App Cristão",
    "slug": "app-cristao",
    "owner": "baux-tech",
    "scheme": "appcristao",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bauxtech.appcristao"
    },
    "android": {
      "package": "com.bauxtech.appcristao",
      "adaptiveIcon": {
        "backgroundColor": "#F4F7FD",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F4F7FD",
          "dark": {
            "backgroundColor": "#0D1117"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O microfone é usado para gravar o culto e transformar a pregação em texto para você.",
          "enableBackgroundRecording": true
        }
      ],
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "A câmera é usada para gravar pedidos em Libras, ler o QR code da célula e fotografar a capa e os materiais.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O Face ID é usado para proteger o seu diário de oração e as suas anotações."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "As fotos são usadas para a capa da célula e para materiais que você escolher.",
          "cameraPermission": "A câmera é usada para gravar pedidos em Libras, ler o QR code da célula e fotografar a capa e os materiais."
        }
      ],
      "expo-sharing",
      "expo-notifications",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "e3e9e31b-1ad3-4cb4-bd06-22861dd53537"
      }
    }
  }
}
