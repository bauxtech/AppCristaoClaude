{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "rewrites": [
    { "source": "/celulas/:nome", "destination": "/celulas/_/index.html" },
    { "source": "/celulas/:nome/", "destination": "/celulas/_/index.html" },
    { "source": "/c/:codigo", "destination": "/c/_/index.html" },
    { "source": "/c/:codigo/", "destination": "/c/_/index.html" }
  ]
}
